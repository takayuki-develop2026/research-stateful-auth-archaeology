RAILS_ENV=development
TZ=Asia/Tokyo

TRUSTLEDGER_LARAVEL_API_BASE_URL=http://nginx
TRUSTLEDGER_ADMIN_API_BASE_URL=http://payment-core:8081
TRUSTLEDGER_ADMIN_X_ADMIN_KEY=dev-local-admin-key

TRUSTLEDGER_ADMIN_PROVIDERINTEL_PATH=/api/admin/providerintel
TRUSTLEDGER_ADMIN_PROVIDERINTEL_SOURCES_PATH=/api/admin/providerintel/sources

ATLASKERNEL_ADMIN_API_BASE_URL=http://nginx
ATLASKERNEL_ADMIN_DISCOVERY_OPS_PATH=/api/admin/atlaskernel/discovery-ops
ATLASKERNEL_DEFAULT_PROJECT_ID=akproj_0000000000000000000

AI_RUNTIME_ADMIN_API_BASE_URL=http://host.docker.internal:9082
AI_RUNTIME_ADMIN_BASE_PATH=/api/admin/atlaskernel/ai-runtime
AI_RUNTIME_ADMIN_CATALOG_PATH=/api/admin/atlaskernel/ai-runtime/catalog
AI_RUNTIME_ADMIN_RUNS_PATH=/api/admin/atlaskernel/ai-runtime/runs
AI_RUNTIME_ADMIN_EVIDENCE_BASE_PATH=/api/admin/atlaskernel/ai-runtime/evidence
AI_RUNTIME_ADMIN_EVIDENCE_UPLOAD_PATH=/api/admin/atlaskernel/ai-runtime/evidence/upload
AI_RUNTIME_ADMIN_EVIDENCE_SHOW_BASE_PATH=/api/admin/atlaskernel/ai-runtime/evidence

DECISIONCORE_BASE_URL=http://decisioncore_server:9023