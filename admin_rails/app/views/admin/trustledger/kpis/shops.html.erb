<%= render "admin/trustledger/nav" %>

<h1>ショップ別KPI</h1>

<form method="get" style="margin-bottom: 16px;">
  <label>開始日: <input name="from" value="<%= params[:from] %>" placeholder="YYYY-MM-DD"></label>
  <label style="margin-left:12px;">終了日: <input name="to" value="<%= params[:to] %>" placeholder="YYYY-MM-DD"></label>
  <label style="margin-left:12px;">表示件数: <input name="limit" value="<%= params[:limit].presence || 20 %>" style="width:80px;"></label>
  <button type="submit" style="margin-left:12px;">適用</button>
</form>

<% if @error.present? %>
  <h2 style="color:red;">エラー</h2>
  <pre><%= JSON.pretty_generate(@error) %></pre>
<% else %>

  <% def jpy(n) %>
    <% return "-" if n.nil? %>
    <%= n.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\1,').reverse %>
  <% end %>

  <%# provider style %>
  <% def provider_style(p) %>
    <% key = p.to_s.downcase %>
    <% case key %>
    <% when "stripe" %>
      <% return { label: "Stripe", border: "#7c3aed", bg: "#faf5ff", text: "#5b21b6" } %>
    <% when "adyen" %>
      <% return { label: "Adyen", border: "#16a34a", bg: "#f0fdf4", text: "#166534" } %>
    <% when "paypal" %>
      <% return { label: "PayPal", border: "#2563eb", bg: "#eff6ff", text: "#1e40af" } %>
    <% else %>
      <% return { label: (p.presence || "unknown"), border: "#6b7280", bg: "#f9fafb", text: "#374151" } %>
    <% end %>
  <% end %>

  <% data = @data || {} %>
  <% items = data["items"] || [] %>

  <%# ✅ 期間はparams優先（APIのitemsにfrom/toがないケースに耐える） %>
  <% from_q = params[:from].presence || data["from"] %>
  <% to_q   = params[:to].presence   || data["to"] %>

  <p style="color:#555;">
    期間：<strong><%= from_q %></strong> 〜 <strong><%= to_q %></strong>
    ／ 通貨：<strong><%= data["currency"] || "JPY" %></strong>
  </p>

  <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; width: 100%;">
    <thead>
      <tr>
        <th>shop_id</th>
        <th>ショップ名</th>
        <th>種別</th>
        <th>オーナー</th>
        <th>売上</th>
        <th>返金</th>
        <th>手数料</th>
        <th>純額</th>
        <th>仕訳件数</th>
        <th>PSP別</th>
        <th>監査</th>
      </tr>
    </thead>

    <tbody>
      <% items.each do |s| %>
        <% type_label =
          case s["shop_type"]
          when "personal" then "個人"
          when "business" then "法人"
          else "-"
          end
        %>

        <% byp = s["by_provider"] %>
        <% providers = byp.is_a?(Hash) ? byp.keys.map(&:to_s).sort : [] %>

        <tr>
          <td><%= s["shop_id"] %></td>
          <td><%= s["shop_name"] || "-" %></td>
          <td><%= type_label %></td>
          <td><%= s["owner_name"] || "-" %></td>
          <td><%= jpy(s["sales_total"]) %></td>
          <td><%= jpy(s["refund_total"]) %></td>
          <td><%= jpy(s["fee_total"]) %></td>
          <td><%= jpy(s["net_total"]) %></td>
          <td><%= s["postings_count"] || "-" %></td>

          <td style="min-width:260px;">
            <% if providers.empty? %>
              <span style="color:#666;">-</span>
            <% else %>
              <div style="display:flex; flex-wrap:wrap; gap:6px;">
                <% providers.each do |p| %>
                  <% row = byp[p] || {} %>
                  <% st = provider_style(p) %>

                  <a
                    href="/admin/trustledger/postings?from=<%= from_q %>&to=<%= to_q %>&shop_id=<%= s["shop_id"] %>&provider=<%= p %>"
                    style="text-decoration:none;"
                    title="postingsへ（shop+provider）"
                  >
                    <div style="border:1.5px solid <%= st[:border] %>; background:<%= st[:bg] %>; border-radius:999px; padding:4px 8px;">
                      <span style="font-weight:700; color:<%= st[:text] %>;"><%= st[:label] %></span>
                      <span style="color:#374151; margin-left:6px;">
                        net: <strong><%= jpy(row["net_total"]) %></strong>
                      </span>
                      <span style="color:#6b7280; margin-left:6px; font-size:12px;">
                        (n=<%= row["postings_count"] || 0 %>)
                      </span>
                    </div>
                  </a>
                <% end %>
              </div>
            <% end %>
          </td>

          <td>
  <%= link_to "仕訳を見る",
    admin_postings_path(from: from_q, to: to_q, shop_id: s["shop_id"]) %>
</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p style="margin-top:12px;">
    <a href="/admin/trustledger/kpis/global?from=<%= from_q %>&to=<%= to_q %>">→ 全体KPIへ</a>
    <span style="margin:0 8px;">|</span>
    <a href="/admin/trustledger/reconciliation/missing-sales?from=<%= from_q %>&to=<%= to_q %>">→ 欠損検知へ</a>
  </p>

  <details style="margin-top: 12px;">
    <summary>Raw JSON（監査用）</summary>
    <pre><%= JSON.pretty_generate(@data) %></pre>
  </details>

<% end %>