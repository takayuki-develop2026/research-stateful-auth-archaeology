<%= render "admin/trustledger/nav" %>

<h1>全体KPI</h1>

<p style="margin:8px 0;">
  <a href="http://localhost/login">→ ログインへ</a>
</p>

<form method="get" style="margin-bottom: 16px;">
  <label>開始日: <input name="from" value="<%= params[:from] %>" placeholder="YYYY-MM-DD"></label>
  <label style="margin-left:12px;">終了日: <input name="to" value="<%= params[:to] %>" placeholder="YYYY-MM-DD"></label>
  <button type="submit" style="margin-left:12px;">適用</button>
</form>

<% if @error.present? %>
  <h2 style="color:red;">エラー</h2>
  <pre><%= JSON.pretty_generate(@error) %></pre>
<% else %>

  <% def jpy(n) %>
    <% return "-" if n.nil? %>
    <%= n.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\1,').reverse %>
  <% end %>

  <% data = @data || {} %>

  <%# 画面パラメータ優先（nullや未設定でも耐える） %>
  <% from_q = params[:from].presence || data["from"] %>
  <% to_q   = params[:to].presence   || data["to"] %>

  <p style="color:#555;">
    期間：<strong><%= data["from"] %></strong> 〜 <strong><%= data["to"] %></strong>
    ／ 通貨：<strong><%= data["currency"] || "JPY" %></strong>
  </p>

  <%# =========================
     Provider label/color map
     ========================= %>
  <% def provider_style(p) %>
    <% key = p.to_s.downcase %>
    <% case key %>
    <% when "stripe" %>
      <% return { label: "Stripe", border: "#7c3aed", bg: "#faf5ff", text: "#5b21b6" } %>
    <% when "adyen" %>
      <% return { label: "Adyen(テストクレジットカードの為手数料０円)", border: "#16a34a", bg: "#f0fdf4", text: "#166534" } %>
    <% when "paypal" %>
      <% return { label: "PayPal", border: "#2563eb", bg: "#eff6ff", text: "#1e40af" } %>
    <% else %>
      <% return { label: (p.presence || "unknown"), border: "#6b7280", bg: "#f9fafb", text: "#374151" } %>
    <% end %>
  <% end %>

  <div style="display:flex; gap:12px; flex-wrap:wrap; margin: 12px 0;">
    <div style="flex: 1 1 220px; border:1px solid #ddd; padding:12px; border-radius:8px; background:#fafafa;">
      <div style="color:#666;">売上合計</div>
      <div style="font-size:24px; font-weight:700;"><%= jpy(data["sales_total"]) %></div>
    </div>

    <div style="flex: 1 1 220px; border:1px solid #ddd; padding:12px; border-radius:8px; background:#fafafa;">
      <div style="color:#666;">返金合計</div>
      <div style="font-size:24px; font-weight:700;"><%= jpy(data["refund_total"]) %></div>
    </div>

    <div style="flex: 1 1 220px; border:1px solid #ddd; padding:12px; border-radius:8px; background:#fafafa;">
      <div style="color:#666;">手数料合計</div>
      <div style="font-size:24px; font-weight:700;"><%= jpy(data["fee_total"]) %></div>
    </div>

    <div style="flex: 1 1 220px; border:1px solid #ddd; padding:12px; border-radius:8px; background:#fafafa;">
      <div style="color:#666;">純額（ネット取引差引支給額）</div>
      <div style="font-size:24px; font-weight:700;"><%= jpy(data["net_total"]) %></div>
    </div>

    <div style="flex: 1 1 220px; border:1px solid #ddd; padding:12px; border-radius:8px; background:#fafafa;">
      <div style="color:#666;">仕訳件数</div>
      <div style="font-size:24px; font-weight:700;"><%= data["postings_count"] || "-" %></div>
    </div>
  </div>

  <%# =========================
     PSP別内訳（カード全体クリック）
     ========================= %>
  <% byp = data["by_provider"] %>
  <% providers = byp.is_a?(Hash) ? byp.keys.map(&:to_s).sort : [] %>

  <h2 style="margin-top:18px;">PSP別（Provider別）内訳</h2>

  <% if providers.empty? %>
    <p style="color:#666;">この期間の provider 別データはありません（by_provider が空）。</p>
  <% else %>
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin: 12px 0;">
      <% providers.each do |p| %>
        <% row = byp[p] || {} %>
        <% st = provider_style(p) %>

        <%# ✅ カード全体をクリック可能にする（文字リンクは出さない） %>
        <a
          href="/admin/trustledger/postings?from=<%= from_q %>&to=<%= to_q %>&provider=<%= p %>"
          style="text-decoration:none; color:inherit; flex: 1 1 260px;"
          title="postingsへ（provider=<%= p %>）"
        >
          <div
            style="
              border:2px solid <%= st[:border] %>;
              padding:12px;
              border-radius:10px;
              background:<%= st[:bg] %>;
              cursor:pointer;
            "
            onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)';"
            onmouseout="this.style.boxShadow='none';"
          >
            <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
              <div style="font-weight:800; color:<%= st[:text] %>;">
                <%= st[:label] %>
              </div>
              <div style="font-size:12px; color:#6b7280;">
                postings: <strong><%= row["postings_count"] || 0 %></strong>
              </div>
            </div>

            <div style="margin-top:10px; display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
              <div style="background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                <div style="color:#6b7280; font-size:12px;">売上</div>
                <div style="font-size:18px; font-weight:800;"><%= jpy(row["sales_total"]) %></div>
              </div>

              <div style="background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                <div style="color:#6b7280; font-size:12px;">返金</div>
                <div style="font-size:18px; font-weight:800;"><%= jpy(row["refund_total"]) %></div>
              </div>

              <div style="background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                <div style="color:#6b7280; font-size:12px;">手数料</div>
                <div style="font-size:18px; font-weight:800;"><%= jpy(row["fee_total"]) %></div>
              </div>

              <div style="background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                <div style="color:#6b7280; font-size:12px;">ネット取引差引支給額</div>
                <div style="font-size:18px; font-weight:900;"><%= jpy(row["net_total"]) %></div>
              </div>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>

  <p style="margin-top:12px;">
    <a href="/admin/trustledger/reconciliation/missing-sales?from=<%= from_q %>&to=<%= to_q %>">→ 欠損検知（Reconciliation）へ</a>
    <span style="margin:0 8px;">|</span>
    <a href="/admin/trustledger/postings?from=<%= from_q %>&to=<%= to_q %>">→ 仕訳（Postings）で監査</a>
  </p>

  <details style="margin-top: 12px;">
    <summary>Raw JSON（監査用）</summary>
    <pre><%= JSON.pretty_generate(@data) %></pre>
  </details>

<% end %>