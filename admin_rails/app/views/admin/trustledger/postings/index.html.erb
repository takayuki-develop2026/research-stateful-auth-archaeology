<%= render "admin/trustledger/nav" %>

<h1>仕訳（Postings）一覧</h1>

<%# =========================
   Provider label/color map（KPIページと同じ）
   ========================= %>
<% def provider_style(p) %>
  <% key = p.to_s.downcase %>
  <% case key %>
  <% when "stripe" %>
    <% return { label: "Stripe", border: "#7c3aed", bg: "#faf5ff", text: "#5b21b6" } %>
  <% when "adyen" %>
    <% return { label: "Adyen", border: "#16a34a", bg: "#f0fdf4", text: "#166534" } %>
  <% when "paypal" %>
    <% return { label: "PayPal", border: "#2563eb", bg: "#eff6ff", text: "#1e40af" } %>
  <% else %>
    <% return { label: (p.presence || "unknown"), border: "#6b7280", bg: "#f9fafb", text: "#374151" } %>
  <% end %>
<% end %>

<form method="get" style="margin-bottom: 16px;">
  <label>開始日:
    <input name="from" value="<%= params[:from] %>" placeholder="YYYY-MM-DD">
  </label>

  <label style="margin-left:12px;">終了日:
    <input name="to" value="<%= params[:to] %>" placeholder="YYYY-MM-DD">
  </label>

  <label style="margin-left:12px;">種別:
    <input name="posting_type" value="<%= params[:posting_type] %>" style="width:120px;">
  </label>

  <label style="margin-left:12px;">provider:
    <select name="provider" style="width:140px;">
      <option value="" <%= params[:provider].blank? ? "selected" : "" %>>all</option>
      <option value="stripe" <%= params[:provider] == "stripe" ? "selected" : "" %>>stripe</option>
      <option value="adyen"  <%= params[:provider] == "adyen"  ? "selected" : "" %>>adyen</option>
      <option value="paypal" <%= params[:provider] == "paypal" ? "selected" : "" %>>paypal</option>
      <option value="unknown" <%= params[:provider] == "unknown" ? "selected" : "" %>>unknown</option>
    </select>
  </label>

  <label style="margin-left:12px;">shop_id:
    <input name="shop_id" value="<%= params[:shop_id] %>" style="width:80px;">
  </label>

  <label style="margin-left:12px;">order_id:
    <input name="order_id" value="<%= params[:order_id] %>" style="width:80px;">
  </label>

  <label style="margin-left:12px;">payment_id:
    <input name="payment_id" value="<%= params[:payment_id] %>" style="width:80px;">
  </label>

  <label style="margin-left:12px;">source_event_id:
    <input name="source_event_id" value="<%= params[:source_event_id] %>" style="width:220px;">
  </label>

  <label style="margin-left:12px;">件数:
    <input name="limit" value="<%= params[:limit].presence || 50 %>" style="width:80px;">
  </label>

  <label style="margin-left:12px;">検索(q):
    <input name="q" value="<%= params[:q] %>" style="width:220px;">
  </label>

  <button type="submit" style="margin-left:12px;">検索</button>
</form>

<% active = request.query_parameters.slice("provider","shop_id","order_id","payment_id","posting_type","source_event_id").reject { |_,v| v.blank? } %>
<% if active.any? %>
  <div style="margin:8px 0; color:#333;">
    <strong>適用中フィルタ:</strong>
    <%= active.map { |k,v| "#{k}=#{v}" }.join(" / ") %>
    <span style="margin-left:8px;">
      <a href="/admin/trustledger/postings">クリア</a>
    </span>
  </div>
<% end %>

<% if @error.present? %>
  <pre><%= JSON.pretty_generate(@error) %></pre>
<% else %>

  <% def jp_posting_type(t) %>
    <% return "-" if t.nil? %>
    <% s = t.to_s %>
    <% return "売上" if s == "sale" %>
    <% return "手数料" if s == "fee" %>
    <% return "返金" if s == "refund" %>
    <%= s %>
  <% end %>

  <%# ✅ sale金額の索引（手数料率を逆算するため） %>
  <% sale_amount_by_key = {} %>
  <% @items.each do |row| %>
    <% t = (row["posting_type"] || row["type"]).to_s %>
    <% next unless t == "sale" %>
    <% k = [row["shop_id"], row["order_id"], row["payment_id"]].join(":") %>
    <% sale_amount_by_key[k] = row["amount"].to_f %>
  <% end %>

  <p style="margin:8px 0; color:#555;">
    表示件数: <strong><%= @items.length %></strong>
  </p>

  <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; width: 100%;">
    <thead>
      <tr>
        <th>posting_id</th>
        <th>occurred_at</th>
        <th>種別</th>
        <th>金額</th>
        <th>provider</th>
        <th>shop_id</th>
        <th>order_id</th>
        <th>payment_id</th>
        <th>source_event_id</th>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |p| %>
        <% prov = (p["source_provider"] || "unknown").to_s %>
        <% st = provider_style(prov) %>

        <% posting_type = (p["posting_type"] || p["type"]).to_s %>
        <% is_fee = (posting_type == "fee") %>

        <%# オレンジ系（通常/濃い） %>
        <% fee_orange = "#d97706" %>
        <% fee_orange_strong = "#5a2f24" %>
        <span style="color:<%= fee_orange_strong %>; font-weight:900; font-size:12px; text-shadow: 0 0 1px <%= fee_orange_strong %>;">

        <% fee_style = "color:#{fee_orange}; font-weight:800;" %>

        <%# ✅ 手数料率（%）を sale から逆算 %>
        <% fee_rate_pct = nil %>
        <% if is_fee %>
          <% key = [p["shop_id"], p["order_id"], p["payment_id"]].join(":") %>
          <% base = sale_amount_by_key[key] %>
          <% if base && base > 0 %>
            <% fee_rate_pct = (p["amount"].to_f / base * 100.0) %>
          <% end %>
        <% end %>

        <% fee_rate_label = fee_rate_pct ? ("%.2f" % fee_rate_pct).sub(/\.00$/, "") : nil %>

        <tr>
          <td>
            <a href="/admin/trustledger/postings/<%= p["posting_id"] || p["id"] %>">
              <%= p["posting_id"] || p["id"] %>
            </a>
          </td>

          <td><%= fmt_jst(p["occurred_at"]) %></td>

          <%# =========================
             種別セル：手数料(fee) / (手数料率) / fee の3段
             ========================= %>
          <td>
            <div>
              <span style="<%= is_fee ? fee_style : "" %>">
                <%= jp_posting_type(posting_type) %>
              </span>
            </div>


            <div style="font-size:11px; margin-top:1px;">
              <span style="<%= is_fee ? "color:#{fee_orange}; font-weight:700;" : "color:#666;" %>">
                <%= posting_type %>
              </span>
            </div>
          </td>

          <%# =========================
             金額セル：fee のときだけ右下に（%）を濃い色で
             ========================= %>
          <td>
            <% if is_fee %>
              <div style="display:inline-block; line-height:1.05;">
                <div style="<%= fee_style %>"><%= p["amount"] %></div>
                <div style="text-align:right; font-size:11px; margin-top:2px;">
                  <% if fee_rate_label %>
                    <span style="color:<%= fee_orange_strong %>; font-weight:900;">
                      （<%= fee_rate_label %>%）
                    </span>
                  <% else %>
                    <span style="color:<%= fee_orange_strong %>; font-weight:900;">（-%）</span>
                  <% end %>
                </div>
              </div>
            <% else %>
              <%= p["amount"] %>
            <% end %>
          </td>

          <%# ✅ KPIと同じ色で provider 名を表示 %>
          <td>
            <span
              style="
                color:<%= st[:text] %>;
                font-weight:800;
                border:1px solid <%= st[:border] %>;
                background:<%= st[:bg] %>;
                border-radius:999px;
                padding:2px 8px;
                display:inline-block;
              "
              title="<%= prov %>"
            >
              <%= st[:label] %>
            </span>
          </td>

          <td><%= p["shop_id"] %></td>
          <td><%= p["order_id"] %></td>
          <td><%= p["payment_id"] %></td>
          <td style="font-family: monospace;"><%= p["source_event_id"] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <details style="margin-top: 12px;">
    <summary>Raw JSON</summary>
    <pre><%= JSON.pretty_generate(@data) %></pre>
  </details>
<% end %>