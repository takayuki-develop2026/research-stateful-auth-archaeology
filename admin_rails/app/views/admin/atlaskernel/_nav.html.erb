<%# admin_rails/app/views/admin/atlaskernel/_nav.html.erb %>
<% pid = (params[:project_id].presence || @project_id.presence || ENV["ATLASKERNEL_DEFAULT_PROJECT_ID"]) %>
<% pid_q = pid.present? ? "?project_id=#{pid}" : "" %>
<% current_path = request.path.to_s %>

<div style="padding:12px; border:1px solid #ddd; background:#fff; margin:12px 0;">
  <strong>AtlasKernel 管理</strong>
  <div style="margin-top:8px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
    <a href="/admin/dashboard/atlaskernel<%= pid_q %>">Dashboard</a>
    <a href="/admin/dashboard/atlaskernel/run-artifacts<%= pid_q %>">Run Artifacts</a>
    <a href="/admin/dashboard/atlaskernel/discovery-ops/stale<%= pid_q %>">Discovery Ops (Stale)</a>
    <a href="/admin/dashboard/atlaskernel/discovery-ops/retry<%= pid_q %>">Retry</a>
    <a href="/admin/dashboard/atlaskernel/discovery-ops/apply-retry<%= pid_q %>">Apply Retry</a>
    <a href="/admin/dashboard/atlaskernel/discovery-ops/archived<%= pid_q %>">Archived</a>
    <a href="/admin/dashboard/decisioncore<%= pid_q %>">DecisionCore (v23)</a>
    <a href="/admin/dashboard/decisioncore/decisions<%= pid_q %>">Decisions</a>

    <span style="color:#aaa;">|</span>
    <a href="/admin/dashboard<%= pid_q %>" style="text-decoration:none;">ダッシュボードへ戻る</a>
  </div>

  <div style="margin-top:10px; display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
    <form method="get" action="<%= current_path %>" style="display:flex; gap:8px; align-items:flex-end;">
      <div>
        <label style="font-size:12px; color:#555;">project_id</label><br>
        <input name="project_id" value="<%= pid %>" placeholder="akproj_..." style="width:360px; padding:6px 10px; border:1px solid #ddd; border-radius:10px;" />
      </div>
      <button type="submit" style="padding:6px 12px; border:1px solid #ddd; border-radius:10px; background:#222; color:#fff; cursor:pointer;">
        Set
      </button>
    </form>

    <div style="color:#666; font-size:12px;">
      project_id: <%= pid.presence || "(required)" %>
    </div>
  </div>
</div>

<div style="padding:12px; border:1px solid #ddd; background:#fff; margin:12px 0;">
  <strong>TrustLedger 管理</strong>
  <div style="margin-top:8px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
    <a href="/admin/dashboard/trustledger<%= pid_q %>">Dashboard</a>
    <a href="/admin/dashboard/trustledger/kpis/global<%= pid_q %>">All KPI</a>
  </div>

  <div style="margin-top:10px; color:#666; font-size:12px;">
    project_id: <%= pid.presence || "(required)" %>
  </div>
</div>