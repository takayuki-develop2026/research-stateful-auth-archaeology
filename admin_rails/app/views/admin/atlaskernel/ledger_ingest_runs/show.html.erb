<%= render "admin/trustledger/nav" %>

<h1>Ledger Ingest Run</h1>

<p>
  <%= link_to "← Back", "/admin/dashboard/atlaskernel/ledger/ingest-runs?project_id=#{ERB::Util.url_encode(@project_id)}" %>
</p>

<% if @error %>
  <div style="padding:12px; border:1px solid #f99; background:#fff5f5; margin:12px 0;">
    <strong>API Error</strong><br>
    <div>status: <%= @error[:status] %></div>
    <pre style="white-space:pre-wrap;"><%= JSON.pretty_generate(@error[:body]) rescue @error[:body].to_s %></pre>
  </div>
  <% return %>
<% end %>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin:12px 0;">
  <div style="border:1px solid #ddd; padding:12px; background:#fff;">
    <div style="color:#666; font-size:12px;">ID</div>
    <div style="font-size:14px;"><%= @run["id"] %></div>

    <div style="color:#666; font-size:12px; margin-top:10px;">Status</div>
    <div style="font-size:14px;"><%= @run["status"] %></div>

    <div style="color:#666; font-size:12px; margin-top:10px;">Mode</div>
    <div style="font-size:14px;"><%= @run["mode"] %></div>

    <div style="color:#666; font-size:12px; margin-top:10px;">Time Range</div>
    <div style="font-size:14px;"><%= @run["from_ts"] %> → <%= @run["to_ts"] %></div>

    <div style="color:#666; font-size:12px; margin-top:10px;">Trace/Run</div>
    <div style="font-size:12px; font-family:monospace;">
      trace_id: <%= @run["trace_id"] %><br>
      run_id: <%= @run["run_id"] %><br>
      policy_version_id: <%= @run["policy_version_id"] %>
    </div>
  </div>

  <div style="border:1px solid #ddd; padding:12px; background:#fff;">
    <div style="color:#666; font-size:12px;">Filter</div>
    <pre style="white-space:pre-wrap;"><%= JSON.pretty_generate(@run["filter"] || {}) %></pre>

    <div style="color:#666; font-size:12px; margin-top:10px;">Stats</div>
    <pre style="white-space:pre-wrap;"><%= JSON.pretty_generate(@run["stats"] || {}) %></pre>
  </div>
</div>

<h2>Evidence</h2>
<% if @evidences.empty? %>
  <p>No evidence_refs.</p>
<% else %>
  <% @evidences.each do |ev| %>
    <div style="border:1px solid #ddd; padding:12px; background:#fff; margin:10px 0;">
      <% if ev["error"] %>
        <div><strong>Evidence</strong>: <%= ev["evidence_ref"] %> (failed to fetch)</div>
        <% if ev["error_message"] %>
          <div style="color:#a00; font-size:12px;"><%= ev["error_message"] %></div>
        <% end %>
      <% else %>
        <div style="display:flex; justify-content:space-between; gap:12px;">
          <div>
            <div><strong>evidence_ref</strong>: <%= ev["evidence_ref"] %></div>
            <div><strong>id</strong>: <%= ev["id"] %></div>
            <div><strong>source_uri</strong>: <%= ev["source_uri"] %></div>
          </div>
          <div style="text-align:right; font-size:12px; color:#666;">
            <div><%= ev["media_type"] %> / <%= ev["mime_type"] %></div>
            <div>len=<%= ev["content_length"] %></div>
            <div>sha=<%= ev["content_sha256"] %></div>
          </div>
        </div>

        <% ref = ev["evidence_ref"] %>
        <% content = (@evidence_contents && @evidence_contents[ref]) ? @evidence_contents[ref] : "" %>

        <details style="margin-top:10px;">
          <summary style="cursor:pointer;">Reject JSON (content)</summary>
          <pre style="white-space:pre-wrap; background:#fafafa; border:1px solid #eee; padding:10px; margin-top:8px;"><%= content.to_s %></pre>
        </details>
      <% end %>
    </div>
  <% end %>
<% end %>