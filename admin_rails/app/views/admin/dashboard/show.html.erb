<%# app/views/admin/dashboard/show.html.erb %>

<% occore_web = ENV["OCCORE_WEB_BASE_URL"] || "http://localhost" %>
<%= link_to "ログインへ戻る", "#{occore_web}/login", class: "badge badge--link" %>

<%# AtlasKernel 側の project_id を URL に引き回す（未指定なら環境変数から） %>
<% pid = params[:project_id].presence || ENV["ATLASKERNEL_DEFAULT_PROJECT_ID"] %>
<% pid_q = pid ? "?project_id=#{pid}" : "" %>

<%# OCC 側 Atlas Review（Phase 1 暫定URL） %>
<% occ_atlas_review_url = "#{occore_web}/shops/ALL/dashboard/atlas/requests" %>
<% occ_atlas_apply_logs_url = "#{occore_web}/shops/ALL/dashboard/atlas/history" %>
<% occ_atlas_quarantine_url = "#{occore_web}/shops/ALL/dashboard/atlas/requests?filter=high_risk_review" %>

<%# 有効範囲：TrustLedger for OCC + AtlasKernel for OCC を有効化 %>
<% enabled = {
  atlaskernel: true,
  atlaskernel_occ: true,
  trustledger: false,
  trustledger_occ: true
} %>

<div class="dash">
  <header class="dash__header">
    <div>
      <h1 class="dash__title">Admin Dashboard</h1>
      <p class="dash__subtitle">
        AtlasKernel / TrustLedger の運用・レビュー・監査の統合入口
      </p>
    </div>

    <div class="dash__badges">
      <span class="badge badge--muted">env: <%= Rails.env %></span>
      <span class="badge badge--muted">role: developer</span>
      <% base = ENV["LARAVEL_ADMIN_API_BASE_URL"] || "http://localhost" %>
      <span class="badge badge--muted">api: <%= base %></span>
      <span class="badge badge--muted">project_id: <%= pid || "(required)" %></span>
    </div>
  </header>

  <section class="dash__grid">
    <!-- =============== AtlasKernel =============== -->
    <div
      class="card <%= enabled[:atlaskernel] ? "" : "card--disabled" %>"
      <%= tag.attributes(dash_card_link(enabled: enabled[:atlaskernel], href: "/admin/dashboard/atlaskernel#{pid_q}")) %>
    >
      <div class="card__top">
        <div>
          <h2 class="card__title">AtlasKernel</h2>
          <p class="card__desc">Provider Intelligence / Review / Replay / AI Runtime の運用OS</p>
        </div>
        <span></span>
      </div>

      <div class="card__actions">
        <%= dash_action("AtlasKernel へ", "/admin/dashboard/atlaskernel#{pid_q}", enabled: enabled[:atlaskernel], style: :primary) %>
        <%= dash_action("AI Runtime", "/admin/dashboard/atlaskernel/ai-runtime#{pid_q}", enabled: enabled[:atlaskernel], style: :ghost) %>
        <%= dash_action("Run Artifacts", "/admin/dashboard/atlaskernel/run-artifacts#{pid_q}", enabled: enabled[:atlaskernel], style: :ghost) %>
        <%= dash_action("Discovery Ops (Stale)", "/admin/dashboard/atlaskernel/discovery-ops/stale#{pid_q}", enabled: enabled[:atlaskernel], style: :ghost) %>
      </div>

      <div class="card__meta">
        <div class="kv">
          <span class="kv__k">Status</span>
          <span class="kv__v">
            <% if enabled[:atlaskernel] %>
              <span class="dot dot--ok"></span> OCR(簡易(開発途中)光学文字認識)
            <% else %>
              <span class="dot dot--muted"></span> coming soon
            <% end %>
          </span>
        </div>
        <div class="kv">
          <span class="kv__k">Primary</span>
          <span class="kv__v">Discovery Ops → AI Runtime → Review → Decide</span>
        </div>
      </div>

      <% unless enabled[:atlaskernel] %>
        <div class="card__stamp">Coming soon</div>
      <% end %>
    </div>

    <!-- =============== AtlasKernel for OCC =============== -->
    <div
      class="card card--right <%= enabled[:atlaskernel_occ] ? "" : "card--disabled" %>"
      <%= tag.attributes(dash_card_link(enabled: enabled[:atlaskernel_occ], href: occ_atlas_review_url)) %>
    >
      <div class="card__top">
        <div>
          <h2 class="card__title">AtlasKernel　for　OmniCommerce Core</h2>
          <p class="card__desc">出品商品・Provider情報(PSP)へ安全に反映する導線(ログインユーザー=テスト用のユーザ5で画面移動できます。①はログインページで待機の別ウィンドウ準備して、ページを別に準備してログイン後ログインをして、②(別ウィンドウ)はテスト用のユーザ5(管理者)でログインページして、待機していた①で開いてください。)</p>
        </div>
        <span class="pill pill--blue">OCC</span>
      </div>

      <div class="card__actions">
        <%= dash_action("マルチテナント 全ショップ出品解析", occ_atlas_review_url, enabled: enabled[:atlaskernel_occ], style: :primary) %>
        <%= dash_action("Apply Logs", occ_atlas_apply_logs_url, enabled: enabled[:atlaskernel_occ], style: :ghost) %>
        <%= dash_action("要確認", occ_atlas_quarantine_url, enabled: enabled[:atlaskernel_occ], style: :dangerGhost) %>
      </div>

      <div class="card__meta">
        <div class="kv">
          <span class="kv__k">Invariant</span>
          <span class="kv__v">project_id / run_id / trace_id</span>
        </div>
        <div class="kv">
          <span class="kv__k">Policy</span>
          <span class="kv__v">default deny → review_required</span>
        </div>
      </div>

      <% unless enabled[:atlaskernel_occ] %>
        <div class="card__stamp">Coming soon</div>
      <% end %>
    </div>

    <!-- =============== TrustLedger =============== -->
    <div
      class="card <%= enabled[:trustledger] ? "" : "card--disabled" %>"
      <%= tag.attributes(dash_card_link(enabled: enabled[:trustledger], href: "/admin/trustledger")) %>
    >
      <div class="card__top">
        <div>
          <h2 class="card__title">TrustLedger</h2>
          <p class="card__desc">Webhook / Posting / Reconciliation / Ledger の監査</p>
        </div>
        <span></span>
      </div>

      <div class="card__actions">
        <%= dash_action("TrustLedger へ", "/admin/trustledger", enabled: enabled[:trustledger], style: :primary, note: "準備中") %>
        <%= dash_action("Webhook", "/admin/trustledger/webhooks", enabled: enabled[:trustledger], style: :ghost, note: "準備中") %>
        <%= dash_action("KPI", "/admin/trustledger/kpis", enabled: enabled[:trustledger], style: :ghost, note: "準備中") %>
        <%= dash_action("Postings", "/admin/trustledger/postings", enabled: enabled[:trustledger], style: :ghost, note: "準備中") %>
      </div>

      <div class="card__meta">
        <div class="kv">
          <span class="kv__k">Idempotency</span>
          <span class="kv__v">processed_webhook_events</span>
        </div>
        <div class="kv">
          <span class="kv__k">SoT</span>
          <span class="kv__v">ledger_* / payout_*</span>
        </div>
      </div>

      <% unless enabled[:trustledger] %>
        <div class="card__stamp">Coming soon</div>
      <% end %>
    </div>

    <!-- =============== TrustLedger for OCC =============== -->
    <div
      class="card card--right <%= enabled[:trustledger_occ] ? "" : "card--disabled" %>"
      <%= tag.attributes(dash_card_link(enabled: enabled[:trustledger_occ], href: "/admin/trustledger")) %>
    >
      <div class="card__top">
        <div>
          <h2 class="card__title">TrustLedger　for　OmniCommerce Core</h2>
          <p class="card__desc">OCC注文→決済→永続記録台帳反映の運用導線</p>
        </div>
        <span class="pill pill--blue">OCC</span>
      </div>

      <div class="card__actions">
        <%= dash_action("マルチテナント TrustLedger へ", "/admin/trustledger", enabled: enabled[:trustledger_occ], style: :primary) %>
        <%= dash_action("Webhook", "/admin/trustledger/webhook-events", enabled: enabled[:trustledger_occ], style: :ghost) %>
        <%= dash_action("KPI", "/admin/trustledger/kpis/global", enabled: enabled[:trustledger_occ], style: :ghost) %>
        <%= dash_action("Postings", "/admin/trustledger/postings", enabled: enabled[:trustledger_occ], style: :ghost) %>
      </div>

      <div class="card__meta">
        <div class="kv">
          <span class="kv__k">Routing</span>
          <span class="kv__v">PSP failover（planned）</span>
        </div>
        <div class="kv">
          <span class="kv__k">Audit</span>
          <span class="kv__v">trace_id 全伝播</span>
        </div>
      </div>
    </div>
  </section>

  <footer class="dash__footer">
    <div class="hint">
      Tip: Primary が日常運用入口。異常時は「要確認 / 例外」を先に見る。
      <span class="hint__muted">（未準備の機能は “Coming soon” として無効化されています）</span>
    </div>
  </footer>
</div>