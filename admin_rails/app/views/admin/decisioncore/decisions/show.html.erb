<%= render "admin/atlaskernel/nav" %>

<h1 style="margin:8px 0 4px;">DecisionCore Decision</h1>

<% pid = params[:project_id].presence %>
<% id = params[:id].to_s %>

<div style="padding:12px; border:1px solid #ddd; border-radius:12px; background:#fff;">
  <div style="font-weight:800;">project_id / decision_id</div>
  <div style="margin-top:6px; font-size:12px; color:#666;">
    project_id: <code><%= pid || "(required)" %></code><br>
    decision_id: <code><%= id %></code>
  </div>
</div>

<div style="margin-top:12px; padding:12px; border:1px solid #ddd; border-radius:12px; background:#fff;">
  <div style="font-weight:800;">Actions</div>

  <form method="post" action="/admin/dashboard/decisioncore/decisions/<%= id %>/approve?project_id=<%= pid %>" style="margin-top:10px;">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <button type="submit" style="padding:8px 12px; border:1px solid #ddd; border-radius:10px; background:#0b5; color:#fff; cursor:pointer;">
      Approve
    </button>
  </form>

  <form method="post" action="/admin/dashboard/decisioncore/decisions/<%= id %>/apply?project_id=<%= pid %>" style="margin-top:12px;">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
      <div>
        <label style="font-size:12px; color:#555;">run_id</label><br>
        <input name="run_id" placeholder="uuid" style="width:340px; padding:8px 10px; border:1px solid #ddd; border-radius:10px;" />
      </div>
      <div>
        <label style="font-size:12px; color:#555;">target_evidence_asset_id</label><br>
        <input name="target_evidence_asset_id" placeholder="例: 45" style="width:160px; padding:8px 10px; border:1px solid #ddd; border-radius:10px;" />
      </div>
      <div>
        <label style="font-size:12px; color:#555;">plan_evidence_asset_id</label><br>
        <input name="plan_evidence_asset_id" placeholder="例: 46" style="width:160px; padding:8px 10px; border:1px solid #ddd; border-radius:10px;" />
      </div>

      <button type="submit" style="padding:8px 12px; border:1px solid #ddd; border-radius:10px; background:#222; color:#fff; cursor:pointer;">
        Apply
      </button>
    </div>

    <div style="margin-top:8px; font-size:12px; color:#666;">
      ※ approved 以外は apply しても actions=[]（v23ゲート）
    </div>
  </form>
</div>